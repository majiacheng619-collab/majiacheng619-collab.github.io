  "voice_segments": [
    {
      "id": "intro",
      "text": "我叫马嘉程，二零二七届本科生。",
      "start": 0.75,
      "end": 4.227,
      "source_start": 0.0,
      "source_end": 3.477
    },
    {
      "id": "ecom_metric",
      "text": "电商教学，累计服务约一千名学员。",
      "start": 5.699055022156574,
      "end": 9.459055022156573,
      "source_start": 3.827,
      "source_end": 7.587
    },
    {
      "id": "ecom_manual",
      "text": "从咨询转化到教学交付，我把反复出现的问题，整理成操作手册。",
      "start": 10.146014032496307,
      "end": 16.706014032496306,
      "source_start": 7.936999999999999,
      "source_end": 14.497
    },
    {
      "id": "ai",
      "text": "三支人工智能叙事短片，从脚本、分镜，到素材、配音与剪辑，由我独立完成。",
      "start": 18.75053489660266,
      "end": 28.050534896602656,
      "source_start": 14.847,
      "source_end": 24.147
    },
    {
      "id": "growth",
      "text": "《萌芽保卫队》，有萌芽、成株与开花三种形态。",
      "start": 29.359028249630725,
      "end": 34.399028249630724,
      "source_start": 25.197000000000003,
      "source_end": 30.237000000000002
    },
    {
      "id": "gameplay",
      "text": "先种谁，保护谁，何时进化，留给玩家决定。",
      "start": 35.29861742983752,
      "end": 40.818617429837516,
      "source_start": 30.587000000000003,
      "source_end": 36.107
    },
    {
      "id": "live",
      "text": "直播间里，我策划主题，调整内容与互动。",
      "start": 42.53601495568685,
      "end": 47.25176495568685,
      "source_start": 36.457,
      "source_end": 41.17275
    },
    {
      "id": "field",
      "text": "线下，我和朋友设计挑战规则，组织现场。",
      "start": 48.31491580502215,
      "end": 52.39491580502215,
      "source_start": 41.52275,
      "source_end": 45.60275
    },
    {
      "id": "outro",
      "text": "点开作品，继续了解每一个项目。",
      "start": 54.275875,
      "end": 57.4,
      "source_start": 45.95275,
      "source_end": 49.076875
    }
  ],
